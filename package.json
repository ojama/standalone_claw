{
  "name": "standalone-claw",
  "version": "1.0.0",
  "description": "Standalone executable for openclaw — bundles Node.js runtime with openclaw so users can double-click to run without installing Node.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:win": "node scripts/build.mjs --target win",
    "build:linux": "node scripts/build.mjs --target linux",
    "build:macos": "node scripts/build.mjs --target macos"
  },
  "dependencies": {
    "openclaw": "2026.3.8"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.14.1",
    "esbuild": "^0.27.3"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.10"
  },
  "pkg": {
    "scripts": [
      "src/openclaw-bundle.cjs"
    ],
    "assets": [
      "node_modules/openclaw/dist/**/*.{html,css,json,svg}",
      "node_modules/openclaw/dist/bundled/**",
      "node_modules/openclaw/dist/canvas-host/**",
      "node_modules/openclaw/dist/control-ui/**",
      "node_modules/openclaw/dist/export-html/**",
      "node_modules/openclaw/dist/channels/**",
      "node_modules/openclaw/dist/cli/**",
      "node_modules/openclaw/dist/line/**",
      "node_modules/openclaw/dist/telegram/**",
      "node_modules/openclaw/dist/*.json",
      "node_modules/openclaw/skills/**",
      "node_modules/openclaw/assets/**",
      "node_modules/@img/**",
      "node_modules/@lydell/**",
      "node_modules/@mariozechner/clipboard-*/**",
      "node_modules/@napi-rs/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/node-llama-cpp/**",
      "node_modules/@reflink/**",
      "node_modules/@snazzah/**",
      "node_modules/koffi/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "outputPath": "dist"
  }
}
